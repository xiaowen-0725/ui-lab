{
  "name": "ui-lab",
  "version": "0.10.0",
  "private": true,
  "author": "UI Lab",
  "license": "MIT",
  "description": "An AI-first composable frontend system — components, blocks, themes, and application recipes",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "typescript",
    "motion"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check:registry": "bun scripts/check-registry.ts",
    "check:skills": "bun scripts/check-skills.ts && bun test tests/ui-lab-skill.test.ts",
    "benchmark:greenfield": "bun run --cwd benchmarks/runs/greenfield-workbench verify",
    "inspiration:capture": "bun scripts/capture-inspiration-screenshots.ts",
    "inspiration:audit": "bun scripts/capture-inspiration-screenshots.ts --audit-only",
    "cli:snapshot": "bun scripts/gen-catalog-snapshot.ts",
    "check:snapshot": "bun scripts/gen-catalog-snapshot.ts --check",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:cli": "bun run --cwd cli typecheck && bun run --cwd cli build",
    "check:usage": "bun scripts/verify-standalone-usage.ts",
    "check:usage-browser": "bun scripts/verify-standalone-usage.ts --browser",
    "check:scroll-lifecycle": "bun test scripts/smooth-scroll-lifecycle.test.tsx",
    "test": "bun test ./tests",
    "check": "bun run typecheck && bun run lint && bun run check:registry && bun run check:catalog && bun run check:architecture && bun run check:snapshot && bun run check:skills",
    "check:system-tokens": "bun scripts/verify-system-tokens.ts",
    "check:catalog": "bun test tests/catalog-coverage.test.ts tests/catalog-contract.test.ts tests/nav-contract.test.ts tests/standalone-usage.test.ts",
    "check:catalog-site": "bun scripts/verify-catalog-site.ts && bun scripts/verify-catalog-deep-links.ts",
    "benchmark:catalog-assets": "bun scripts/verify-application-consumers.ts",
    "check:modal-consumer": "bun scripts/verify-modal-consumer.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "5.4.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@shikijs/transformers": "^4.2.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.4",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "geist": "^1.7.2",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "motion": "^11.15.0",
    "next": "^15.1.4",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.81.0",
    "react-tweet": "^3.3.1",
    "react-use-measure": "^2.1.7",
    "recharts": "3.8.0",
    "shadcn": "4.21.4",
    "shiki": "^4.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@happy-dom/global-registrator": "^20.10.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "jest-axe": "^10.0.0",
    "playwright": "^1.54.0",
    "postcss": "^8.5.1",
    "react-docgen-typescript": "^2.4.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
